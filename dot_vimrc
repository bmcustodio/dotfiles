" Minimal, dependency-free editor config for machines without the development layer.
" Provides syntax highlighting for editing config without any toolchain.
" Sourced by Neovim (via ~/.config/nvim/init.lua).
" Also valid as a plain ~/.vimrc.

set nocompatible

syntax on
filetype plugin indent on

set number
set ruler
set showcmd
set incsearch
set hlsearch
set ignorecase
set smartcase
set expandtab
set shiftwidth=2
set softtabstop=2
set tabstop=2
set autoindent
set backspace=indent,eol,start
set laststatus=2
set wildmenu
set mouse=a

" Built-in colorscheme shipped by both Vim and Neovim (no plugins needed).
silent! colorscheme habamax
